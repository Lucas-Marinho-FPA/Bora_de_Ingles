          "rules": [
            {
              "rule_id": "RULE_TOBE_PRESENT",
              "titulo": "Verbo To Be no Presente",
              "balao": "O verbo \"to be\" inverte de lugar com o sujeito para fazer perguntas e recebe \"not\" para negar: \"Are you at home?\" (Você está em casa?). Nunca use \"do\" ou \"does\" com ele, evitando o erro comum de falar \"Do you are at home?\".",
              "estrutura": "Afirm.: Sujeito + am/is/are + compl. | Neg.: + not | Perg.: Am/Is/Are + sujeito?",
              "exemplo": {
                "en": "Are you at home?",
                "pt": "Você está em casa?"
              },
              "erro_comum": "Usar 'do/does' com o to be (dizer 'Do you are at home?').",
              "pagina_fonte": "15,16,17",
              "frase_ancora": "(a preencher na revisão — não verificável no PDF atual)"
            }
          ]
        }
