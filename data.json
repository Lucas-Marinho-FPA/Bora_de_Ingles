            {
              "rule_id": "RULE_ADJ_ORDER",
              "titulo": "Posição do Adjetivo e Sensações",
              "balao": "O adjetivo vem antes do substantivo. E sensações físicas usam o to be direto, sem 'with' (com): I am hungry, não 'I am with hunger'.",
              "estrutura": "Adjetivo + substantivo (a new house). Sensação: Sujeito + to be + adjetivo (I am hungry / I am cold).",
              "exemplo": {
                "en": "She is a pretty girl.",
                "pt": "Ela é uma garota bonita."
              },
              "erro_comum": "Traduzir 'com fome/frio' usando 'with' ou 'have' ('I am with hungry').",
              "pagina_fonte": "19,20",
              "frase_ancora": "(a preencher na revisão — não verificável no PDF atual)"
